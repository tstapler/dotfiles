#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Set the credentials a repo's release workflow needs to push to tstapler/homebrew-tap as the
tstapler-homebrew-tap-writer GitHub App:

  variable HOMEBREW_TAP_APP_CLIENT_ID    the app's Client ID (not secret)
  secret   HOMEBREW_TAP_APP_PRIVATE_KEY  the app's private key (.pem)

Both are read from one 1Password item: the field labelled "Client ID" and the attached .pem file.
When that is ambiguous (several candidates, none, or the item is not found) the script asks you to
choose, unless --no-input is given, in which case it fails and says why.

The key goes from `op read` into `gh secret set` through memory and a pipe: it is never printed,
never written to disk and never put on a command line. Nothing from the item except the names you
choose between and a non-concealed Client ID is ever printed.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections.abc import Callable, Sequence
from typing import Any

VAR_NAME = "HOMEBREW_TAP_APP_CLIENT_ID"
SECRET_NAME = "HOMEBREW_TAP_APP_PRIVATE_KEY"
DEFAULT_ITEM = "tstapler Homebrew Tap"
CLIENT_ID_LABEL = re.compile(r"^(app(lication)?[ _-]?)?client[ _-]?id$", re.IGNORECASE)
REPO_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
PEM_HEADER = re.compile(r"^-----BEGIN [A-Z ]*PRIVATE KEY-----")

Reader = Callable[[str], str]


class Fatal(Exception):
    """An expected failure: print the message, exit 1."""


def run(cmd: Sequence[str], *, stdin: str | None = None) -> str:
    """Run a command and return stdout. Only the command name and stderr appear in errors, so
    a secret passed through stdin can never leak into a message."""
    proc = subprocess.run(
        list(cmd), input=stdin, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or f"exit {proc.returncode}"
        raise Fatal(f"`{' '.join(cmd[:2])}` failed: {detail}")
    return proc.stdout


def choose(
    title: str, options: list[str], *, interactive: bool, read: Reader = input
) -> int:
    """Return the index of the option the user picks."""
    if not interactive:
        raise Fatal(f"{title}: {len(options)} candidates and --no-input is set")
    print(title, file=sys.stderr)
    for number, option in enumerate(options, 1):
        print(f"  {number}) {option}", file=sys.stderr)
    while True:
        try:
            answer = read(f"Choose 1-{len(options)} (q to quit): ").strip().lower()
        except EOFError:
            raise Fatal("cancelled") from None
        if answer in {"q", "quit"}:
            raise Fatal("cancelled")
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer) - 1
        print("Not a valid choice.", file=sys.stderr)


def get_item(ref: str, vault: str | None) -> dict[str, Any]:
    cmd = ["op", "item", "get", ref, "--format", "json"]
    if vault:
        cmd += ["--vault", vault]
    item: dict[str, Any] = json.loads(run(cmd))
    return item


def pick_item(vault: str | None, *, interactive: bool, read: Reader) -> dict[str, Any]:
    """Let the user choose an item when the configured one cannot be found."""
    cmd = ["op", "item", "list", "--format", "json"]
    if vault:
        cmd += ["--vault", vault]
    items: list[dict[str, Any]] = json.loads(run(cmd))
    needle = (
        read("Filter item titles containing [homebrew]: ").strip().lower() or "homebrew"
    )
    matches = [i for i in items if needle in i.get("title", "").lower()] or items
    labels = [f"{i['title']}  ({i.get('vault', {}).get('name', '?')})" for i in matches]
    chosen = matches[
        choose(
            "Which item holds the app credentials?",
            labels,
            interactive=interactive,
            read=read,
        )
    ]
    return get_item(chosen["id"], vault)


def load_item(
    ref: str, vault: str | None, *, interactive: bool, read: Reader
) -> dict[str, Any]:
    try:
        return get_item(ref, vault)
    except Fatal as err:
        if not interactive:
            raise
        print(f"{err}", file=sys.stderr)
        return pick_item(vault, interactive=interactive, read=read)


def pick_client_id(
    item: dict[str, Any], override: str | None, *, interactive: bool, read: Reader
) -> tuple[str, str]:
    """Return (client id, field label). An exact "Client ID" field is used without asking."""
    if override:
        return override, "--client-id"
    fields = [f for f in item.get("fields") or [] if f.get("label") and f.get("value")]
    matches = [f for f in fields if CLIENT_ID_LABEL.match(f["label"])]
    if len(matches) == 1:
        return matches[0]["value"], matches[0]["label"]
    pool = matches or fields
    if not pool:
        raise Fatal(
            f"item '{item.get('title')}' has no non-empty fields; pass --client-id"
        )
    title = (
        "Several Client ID fields; which one?"
        if matches
        else 'No field is labelled "Client ID". Which field holds it?'
    )
    labels = [
        f["label"] + (" (concealed)" if f.get("type") == "CONCEALED" else "")
        for f in pool
    ]
    chosen = pool[choose(title, labels, interactive=interactive, read=read)]
    return chosen["value"], chosen["label"]


def pick_pem(item: dict[str, Any], *, interactive: bool, read: Reader) -> str:
    names = [f["name"] for f in item.get("files") or []]
    pems = [n for n in names if n.lower().endswith(".pem")]
    if len(pems) == 1:
        return pems[0]
    pool = pems or names
    if not pool:
        raise Fatal(
            f"item '{item.get('title')}' has no attachments; attach the .pem file"
        )
    title = (
        "Several .pem attachments; which one?"
        if pems
        else "No .pem attachment. Which file is the key?"
    )
    return pool[choose(title, pool, interactive=interactive, read=read)]


def read_private_key(item: dict[str, Any], file_name: str) -> str:
    key = run(["op", "read", f"op://{item['vault']['id']}/{item['id']}/{file_name}"])
    if not PEM_HEADER.match(key):
        raise Fatal(f"'{file_name}' is not a PEM private key")
    return key


def listed(kind: str, repo: str, name: str) -> bool:
    out = run(
        ["gh", kind, "list", "--repo", repo, "--json", "name", "--jq", ".[].name"]
    )
    return name in out.split()


def set_credentials(repo: str, client_id: str, key: str) -> bool:
    """Set both values, then read the names back: a write that was accepted but ignored
    looks the same as success."""
    run(["gh", "variable", "set", VAR_NAME, "--repo", repo, "--body", client_id])
    run(
        ["gh", "secret", "set", SECRET_NAME, "--repo", repo],
        stdin=key if key.endswith("\n") else key + "\n",
    )
    return listed("variable", repo, VAR_NAME) and listed("secret", repo, SECRET_NAME)


def parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Set the Homebrew tap GitHub App credentials on one or more repos.",
    )
    parser.add_argument("repos", nargs="+", metavar="OWNER/REPO")
    parser.add_argument(
        "-i",
        "--item",
        default=os.environ.get("HOMEBREW_TAP_APP_OP_ITEM", DEFAULT_ITEM),
        help=f'1Password item (default: $HOMEBREW_TAP_APP_OP_ITEM, else "{DEFAULT_ITEM}")',
    )
    parser.add_argument(
        "--vault", help="vault to look in (default: any vault op can see)"
    )
    parser.add_argument(
        "-c",
        "--client-id",
        help="use this Client ID instead of reading it from the item",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="resolve and show, set nothing, do not read the key",
    )
    parser.add_argument(
        "--no-input",
        action="store_true",
        help="never prompt; fail when a choice is needed",
    )
    args = parser.parse_args(argv)
    for repo in args.repos:
        if not REPO_PATTERN.match(repo):
            parser.error(f"'{repo}' is not OWNER/REPO")
    return args


def main(argv: Sequence[str] | None = None, *, read: Reader = input) -> int:
    args = parse_args(argv)
    interactive = not args.no_input and sys.stdin.isatty()
    try:
        item = load_item(args.item, args.vault, interactive=interactive, read=read)
        client_id, field = pick_client_id(
            item, args.client_id, interactive=interactive, read=read
        )
        pem = pick_pem(item, interactive=interactive, read=read)
        print(f"item:       {item.get('title')}")
        print(f"client id:  {client_id}  (field '{field}')")
        print(f"key file:   {pem}")
        if args.dry_run:
            for repo in args.repos:
                print(
                    f"[dry-run] {repo}: would set variable {VAR_NAME} and secret {SECRET_NAME}"
                )
            return 0
        key = read_private_key(
            item, pem
        )  # read once: one 1Password prompt for any number of repos
        return apply_to_repos(args.repos, client_id, key)
    except Fatal as err:
        print(f"error: {err}", file=sys.stderr)
        return 1


def apply_to_repos(repos: Sequence[str], client_id: str, key: str) -> int:
    failed = False
    for repo in repos:
        try:
            ok = set_credentials(repo, client_id, key)
        except Fatal as err:
            print(f"FAILED  {repo}: {err}", file=sys.stderr)
            failed = True
            continue
        if ok:
            print(f"ok      {repo}")
        else:
            print(
                f"UNVERIFIED  {repo} (set without error but not listed)",
                file=sys.stderr,
            )
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
