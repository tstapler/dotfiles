// Scrapes stapler-squad's net/http/pprof endpoint (exposed only when the app
// is run with --profile, default port 6060 — see docs/how-to/profile-lockups.md
// in the stapler-squad repo) and forwards profiles to the local Pyroscope
// server. Target is host.docker.internal: on Docker Desktop for Mac it reaches
// the app's loopback-only listener, whereas host networking does not (see
// docker-compose.yml).
pyroscope.scrape "stapler_squad" {
  targets = [
    {"__address__" = "host.docker.internal:6060", "service_name" = "stapler-squad"},
  ]
  forward_to = [pyroscope.write.local.receiver]

  // The default timeout fails mutex/block/allocs with "failed to read body:
  // context deadline exceeded" — the app serves these cumulative profiles slowly.
  scrape_interval = "60s"
  scrape_timeout  = "55s"

  // stapler-squad uses plain net/http/pprof (docs/how-to/profile-lockups.md),
  // not the github.com/grafana/pyroscope-go/godeltaprof handlers — so the
  // delta_* endpoints Alloy's godeltaprof_* profile types expect don't
  // exist. Use the cumulative variants (/debug/pprof/heap, /mutex, /block,
  // /goroutine, /profile) and disable every godeltaprof_* block.
  profiling_config {
    profile.process_cpu {
      enabled = true
    }
    profile.memory {
      enabled = true
    }
    profile.goroutine {
      enabled = true
    }
    profile.mutex {
      enabled = true
    }
    profile.block {
      enabled = true
    }
    profile.godeltaprof_memory {
      enabled = false
    }
    profile.godeltaprof_mutex {
      enabled = false
    }
    profile.godeltaprof_block {
      enabled = false
    }
  }
}

pyroscope.write "local" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}

// Host-contention metrics from the native macOS collector (host-collector/).
// It must run outside Docker: prometheus.exporter.unix here would describe the
// Docker VM, not the Mac. job="host" is what the host-contention dashboard and
// alert rules key on.
prometheus.scrape "host" {
  targets = [
    {"__address__" = "host.docker.internal:64891", "instance" = "macos-host"},
  ]
  job_name        = "host"
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.victoriametrics.receiver]
}

// Host filesystem health. host/btrfs_health.py (run by systemd/btrfs-health.timer)
// writes a Prometheus textfile into host/textfile_collector, bind-mounted here
// read-only. Alloy's embedded node_exporter serves ONLY that collector, so no
// host node_exporter, no host port and no host.docker.internal hop is needed.
prometheus.exporter.unix "host_textfile" {
  set_collectors = ["textfile"]

  textfile {
    directory = "/host-textfile"
  }
}

// Pin `instance` so series identity survives container recreation (Alloy's
// default is the container ID).
discovery.relabel "host_textfile" {
  targets = prometheus.exporter.unix.host_textfile.targets

  rule {
    target_label = "instance"
    replacement  = "host"
  }

  // The exporter's targets arrive with job="integrations/unix", which wins over
  // prometheus.scrape's job_name; the alert rules key on this one.
  rule {
    target_label = "job"
    replacement  = "host-textfile"
  }
}

prometheus.scrape "host_textfile" {
  targets         = discovery.relabel.host_textfile.output
  forward_to      = [prometheus.remote_write.victoriametrics.receiver]
  job_name        = "host-textfile"
  scrape_interval = "30s"
}

// Network probe (../vaping-at-home). The probe publishes :9790 on the host; a
// separate compose project can't use service-name DNS, so go via the host
// gateway. `up` is 0 (and the network alerts see no data) while the probe
// isn't running. Metric names are unchanged from the old Prometheus setup.
prometheus.scrape "vaping" {
  targets = [
    {"__address__" = "host.docker.internal:9790", "instance" = "vaping"},
  ]
  forward_to      = [prometheus.remote_write.victoriametrics.receiver]
  job_name        = "vaping"
  scrape_interval = "15s"
}

prometheus.remote_write "victoriametrics" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}
