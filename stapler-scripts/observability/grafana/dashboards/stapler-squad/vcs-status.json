  },
  "description": "GetVCSStatus health: handler latency, git computation time, error/cancel rate, cache and coalescing hit rate.",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "stapler-squad: VCS status",
  "uid": "ssq-vcs-status",
  "tags": [
    "stapler-squad",
    "vcs"
  ],
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "Golden signals: GetVCSStatus",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "GetVCSStatus handler latency (otelconnect)",
      "description": "Server-side handler time as seen by otelconnect: excludes any browser-side queueing. Includes cache hits, so p50 is near zero. Uses increase() because otelconnect labels series with net_peer_port, so every new connection is a fresh series that rate() cannot see.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.5, sum(increase(rpc_server_duration_milliseconds_bucket{rpc_method=\"GetVCSStatus\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum(increase(rpc_server_duration_milliseconds_bucket{rpc_method=\"GetVCSStatus\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum(increase(rpc_server_duration_milliseconds_bucket{rpc_method=\"GetVCSStatus\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Git computation latency (cache misses only)",
      "description": "Wall time of one shared git status computation. A p99 near 30000 means the compute timeout is being hit.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.5, sum(rate(vcs_status_compute_duration_milliseconds_bucket{}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum(rate(vcs_status_compute_duration_milliseconds_bucket{}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum(rate(vcs_status_compute_duration_milliseconds_bucket{}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Error and cancel rate by Connect code",
      "description": "Errors per 5m window by Connect code; canceled = caller left before git finished.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(rpc_server_duration_milliseconds_count{rpc_method=\"GetVCSStatus\",rpc_connect_rpc_error_code!=\"\"}[5m])) by (rpc_connect_rpc_error_code)",
          "legendFormat": "{{rpc_connect_rpc_error_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "Error ratio (alert-ready)",
      "description": "Share of GetVCSStatus calls that returned a Connect error. Alert candidate: > 5% for 10m.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(rpc_server_duration_milliseconds_count{rpc_method=\"GetVCSStatus\",rpc_connect_rpc_error_code!=\"\"}[5m])) / sum(increase(rpc_server_duration_milliseconds_count{rpc_method=\"GetVCSStatus\"}[5m]))",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 106,
      "type": "timeseries",
      "title": "In-flight computations",
      "description": "Git status computations running or waiting for one of 4 slots.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
