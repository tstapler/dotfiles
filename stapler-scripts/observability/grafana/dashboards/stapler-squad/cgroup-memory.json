{
  "title": "stapler-squad cgroup memory",
  "uid": "ssq-cgroup-memory",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "iconColor": "green", "name": "Deploys", "target": { "limit": 100, "matchAny": false, "tags": ["deploy", "stapler-squad"], "type": "tags" }, "type": "tags" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Memory usage vs high/max ceilings",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "cgroup_memory_current_bytes", "legendFormat": "current", "refId": "A" },
        { "expr": "cgroup_memory_high_bytes", "legendFormat": "high (throttle)", "refId": "B" },
        { "expr": "cgroup_memory_max_bytes", "legendFormat": "max (oom-kill)", "refId": "C" }
      ]
    },
    {
      "id": 2,
      "title": "Memory pressure (PSI avg10)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "cgroup_memory_pressure_some_avg10", "legendFormat": "some (>=1 task stalled)", "refId": "A" },
        { "expr": "cgroup_memory_pressure_full_avg10", "legendFormat": "full (every task stalled)", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "High-throttle events (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "increase(cgroup_memory_events_high_total[1h])", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Max-breach events (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "increase(cgroup_memory_events_max_total[1h])", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "OOM events (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "increase(cgroup_memory_events_oom_total[1h])", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "OOM kills (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "increase(cgroup_memory_events_oom_kill_total[1h])", "refId": "A" }]
    }
  ]
}
