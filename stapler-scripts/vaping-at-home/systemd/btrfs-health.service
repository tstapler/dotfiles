[Unit]
Description=Write btrfs allocation/health metrics for node_exporter's textfile collector

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles/stapler-scripts/vaping-at-home
ExecStart=/home/linuxbrew/.linuxbrew/bin/uv run --no-project --quiet --with pyyaml python3 btrfs_health.py
# Reads world-readable sysfs only; no root needed.
NoNewPrivileges=yes
