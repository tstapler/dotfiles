[Unit]
Description=node_exporter for the vaping-at-home Prometheus (host metrics + textfile collector)

[Service]
# Bound to the docker bridge gateway so the Prometheus container reaches it via
# host.docker.internal:host-gateway without exposing :9100 on the LAN.
# Restart covers boot before docker0 exists (user units cannot order after docker.service).
ExecStart=/home/linuxbrew/.linuxbrew/bin/node_exporter \
  --web.listen-address=172.17.0.1:9100 \
  --collector.textfile.directory=%h/dotfiles/stapler-scripts/vaping-at-home/textfile_collector
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
