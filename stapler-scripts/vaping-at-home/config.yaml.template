pidfile: /app/vaping.pid
logging:
  version: 1
  formatters:
    simple:
      format: '%(asctime)s - %(name)s - %(levelname)s: %(message)s'
  handlers:
    console:
      class: logging.StreamHandler
      level: DEBUG
      formatter: simple
      stream: ext://sys.stdout
  loggers:
    vaping:
      level: DEBUG
      handlers: [console]
    vodka:
      level: DEBUG
      handlers: [console]

probes:
  - name: latency_fping
    type: fping
    interval: 5s
    output:
      - prometheus
    groups:
      - name: dns_servers
        hosts:
          - host: ${GATEWAY_IP}
            name: Gateway
          - host: 8.8.8.8
            name: Google
          - host: 1.1.1.1
            name: Cloudflare
          - host: 208.67.222.222
            name: OpenDNS
${TRACEROUTE_HOSTS}

  - name: path_to_google_dns
    type: fping_mtr
    host: 8.8.8.8
    interval: 30s
    count: 5
    output:
      - prometheus

  - name: dns_resolution_timing
    type: command
    command: "python3 /app/dns_probe.py {host}"
    interval: 15s
    output:
      - prometheus
    groups:
      - name: dns_lookup_targets
        hosts:
          - host: google.com
          - host: cloudflare.com
          - host: github.com

plugins:
  - name: prometheus
    type: prometheus
    port: 9099
