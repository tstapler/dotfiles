#!/usr/bin/env bash
# Weekly: delete idle Cargo build output through dunnage's reviewed apply flow (dry run -> plan-id -> apply).
# Only Cargo kinds (cargo-target, cargo-artifact) are selected, never node_modules or other build dirs.
#   cargo-gc-targets [-n]        -n: dry run only, print what would be freed
#   cargo-gc-targets --install   symlink and enable the weekly user timer (cargo-gc/)
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
if [ "${1:-}" = "--install" ]; then
  mkdir -p ~/.config/systemd/user
  ln -sf "$here/cargo-gc/cargo-gc.service" "$here/cargo-gc/cargo-gc.timer" ~/.config/systemd/user/
  systemctl --user daemon-reload && systemctl --user enable --now cargo-gc.timer
  exit
fi
dry=false; [ "${1:-}" = "-n" ] && dry=true
export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
min_age=${CARGO_GC_MIN_AGE:-14d}
common=(--kinds build-dirs --min-age "$min_age" --json)
batch_max=20   # dunnage accepts at most 20 --only values per run

# Capture first so a missing dunnage/jq or a crashed scan fails the unit instead of reading as "nothing idle".
out=$(dunnage "${common[@]}")
jq -e '.items | type == "array"' >/dev/null <<<"$out" || { echo "dunnage returned no .items array" >&2; exit 1; }
paths=()
# NUL-delimited so a path with a newline cannot split; such a path is skipped, not fatal.
while IFS= read -r -d '' p; do
  case $p in *$'\n'*) echo "skip (newline in path): ${p//$'\n'/?}" >&2 ;; *) paths+=("$p") ;; esac
done < <(jq -j '.items[] | select(.status == "would_free" and (.kind == "cargo-target" or .kind == "cargo-artifact")) | .path + "\u0000"' <<<"$out")
if [ "${#paths[@]}" -eq 0 ]; then echo "nothing idle for $min_age"; exit 0; fi
echo "${#paths[@]} idle cargo path(s)"

for ((i = 0; i < ${#paths[@]}; i += batch_max)); do
  batch=("${paths[@]:i:batch_max}")
  only=(); for p in "${batch[@]}"; do only+=(--only "$p"); done
  plan=$(dunnage "${common[@]}" "${only[@]}" | jq -er '.plan_id')
  echo "batch $((i / batch_max + 1)): plan-id $plan"
  printf '  %s\n' "${batch[@]}"
  $dry || dunnage --apply "${common[@]}" "${only[@]}" --plan-id "$plan" >/dev/null
done
