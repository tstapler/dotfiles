#!/usr/bin/env bash
# steam-clean launcher: delegates to `dunnage steam` when dunnage is installed, otherwise runs the old compiled
# steam-clean (cargo install --path stapler-scripts/steam-clean). Not on PATH until the cutover (plan Task 5.2.1e).
# DUNNAGE_BIN overrides the binary, DUNNAGE_LEGACY=1 forces legacy, DUNNAGE_STEAM_LEGACY_BIN names the old binary.
set -euo pipefail

self="$(readlink -f "$0")"

log_use() { # append-only outcome log; a write failure is ignored
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/dunnage"
  { mkdir -p "$dir" && printf '%s steam-clean %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >>"$dir/wrapper-use.log"; } 2>/dev/null || true
}

bin="${DUNNAGE_BIN:-}"
[ -n "$bin" ] || bin="$(command -v dunnage || true)"
if [ -n "$bin" ] && [ -x "$bin" ] && [ "${DUNNAGE_LEGACY:-}" != 1 ] && [ "$(uname -s)" != Darwin ]; then
  case "${1:-list}" in
    tidy)
      log_use retired
      echo "steam-clean: the tidy TUI is retired. Rank with 'steam-clean list'; delete with 'dunnage --kinds steam' (dry run), then the Next: line." >&2
      exit 64
      ;;
    list) [ "$#" -eq 0 ] || shift; set -- steam list "$@" ;;
    *) set -- steam "$@" ;;
  esac
  export DUNNAGE_VIA=steam-clean DISK_CLEANUP_VIA=steam-clean
  exec "$bin" "$@"
fi

legacy="${DUNNAGE_STEAM_LEGACY_BIN:-$HOME/.cargo/bin/steam-clean}"
if [ -x "$legacy" ] && [ "$(readlink -f "$legacy")" != "$self" ]; then
  exec "$legacy" "$@"
fi
echo "steam-clean: refusing to exec itself or a missing legacy binary ($legacy); install dunnage (brew install tstapler/homebrew-tap/dunnage)" >&2
exit 2
