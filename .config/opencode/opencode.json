{
  "permission": {},
  "lsp": {
    "kotlin-lsp": {
      "command": ["/home/tstapler/dotfiles/stapler-scripts/kotlin-lsp-wrapper.sh", "--stdio"],
      "extensions": [".kt", ".kts"],
      "initialization": {
        "settings": {
          "kotlin": {
            "compiler": {
              "jvm": {
                "target": "17"
              }
            },
            "lsp": {
              "debounceTime": 250
            }
          }
        }
      }
    },
    "clojure-lsp": {
      "command": ["/home/tstapler/dotfiles/stapler-scripts/clojure-lsp-wrapper.sh"],
      "extensions": [".clj", ".cljs", ".cljc", ".edn", ".bb"],
      "initialization": {
        "settings": {
          "clojure-lsp": {
            "project-specs": [
              {
                "project-path": "project.clj",
                "classpath-cmd": ["lein", "classpath"]
              },
              {
                "project-path": "deps.edn",
                "classpath-cmd": ["clojure", "-Spath"]
              },
              {
                "project-path": "bb.edn",
                "classpath-cmd": ["bb", "print-deps"]
              },
              {
                "project-path": "build.boot",
                "classpath-cmd": ["boot", "classpath"]
              },
              {
                "project-path": "shadow-cljs.edn",
                "classpath-cmd": ["clojure", "-Spath"]
              }
            ],
            "use-metadata-for-privacy?": false,
            "keep-parens-when-threading?": false,
            "clean": {
              "ns-inner-blocks-indentation": "next-line",
              "sort": {
                "ns-references?": true
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "consolette": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Consolette",
      "options": {
        "baseURL": "http://127.0.0.1:47000/v1",
        "apiKey": "unused"
      },
      "models": {
        "cohere/north-mini-code:free": {
          "name": "North Mini Code (via consolette)"
        },
        "poolside/laguna-s-2.1:free": {
          "name": "Laguna S 2.1 (via consolette)"
        }
      }
    }
  }
}
