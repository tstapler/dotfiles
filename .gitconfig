[init]
	templatedir = ~/.gittemplates
	defaultBranch = main

[core]
	editor = vim
	excludesfile = ~/.gitignore
	symlinks = true
	autocrlf = input

[web]
	browser = google-chrome-stable

[push]
	default = matching

[color]
	ui = auto

[diff]
	tool = meld

[hub]
	protocol = ssh

[user]
	name = Tyler Stapler
	email = tystapler@gmail.com

[alias]
	meld = !git difftool -t meld --dir-diff

[mergetool "meld"]
    cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"

[rebase]
	instructionFormat = (%an <%ae>) %s

[http]
	cookiefile = ~/.gitcookies
[pull]
	rebase = true

[net]
git-fetch-with-cli = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	enabled = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Work identity (name/email) is applied to repos under the work projects
# directory via this include. The fbg role writes ~/.gitconfig.fbg on work
# machines; on personal machines the file is absent and this is a no-op.
[includeIf "gitdir:~/WorkProjects/"]
	path = ~/.gitconfig.fbg
# Generic hand-off for machine-local overlays to contribute their own git config
# (chiefly per-employer identity, keyed on remote URL rather than directory).
# The overlay repo owns the file and its contents; this repo only owns the one
# unconditional include, so no org-specific pattern lands in this public history.
# Absent on machines with no overlay linked, where git treats it as a no-op.
#
# It must be an include rather than a hook: git resolves the commit author BEFORE
# running pre-commit, so a hook that sets user.email only affects the NEXT
# commit. Config is read at commit time, so it is correct on the first one.
[include]
	path = ~/.gitconfig.overlay
[credential]
	helper = !gh auth git-credential
[machete]
	squashMergeDetection = simple
