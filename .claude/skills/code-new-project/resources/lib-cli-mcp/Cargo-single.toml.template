[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2021"
license = "MIT"
description = "{{PROJECT_NAME}} — CLI / MCP tool"

# Rust 1.74+ lints — set once here instead of per-module boilerplate.
[lints.clippy]
all = "warn"
pedantic = "warn"
unwrap_used = "warn"
expect_used = "warn"

[[bin]]
name = "{{PROJECT_NAME}}"
path = "src/main.rs"

[dependencies]
clap = { version = "4", features = ["derive"] }
rmcp = { version = "0.1", features = ["server"] }
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
anyhow = "1"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
