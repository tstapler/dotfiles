# Linux-only Brewfile - no casks, GUI apps excluded
# Maintained manually; update when adding new CLI tools to the main Brewfile.
# Private taps (fanatics-gaming/tap, tstapler/stelekit) are intentionally excluded
# because they require SSH key setup which happens after bootstrap.

# Public first-party CLI releases used by the Pi/Claude toolchain.
tap "tstapler/homebrew-tap", "https://github.com/tstapler/homebrew-tap"

cask "1password-cli"  # op CLI; ships as a cask upstream but is CLI-only, required by secrets role
brew "ansible"
brew "asdf"          # required by asdf role
brew "bat"
brew "coreutils"
brew "curl"
brew "fd"
brew "fzf"
brew "git"
brew "git-lfs"
brew "gh"
brew "golang"
brew "htop"
brew "jq"
brew "tstapler/homebrew-tap/kibitzer"  # diff-aware code/doc inspection hook for Claude Code
brew "neovim"
brew "node"
brew "ollama", restart_service: :changed
brew "python@3.12"
brew "ripgrep"
brew "rust"           # builds the pinned stapler-mcp source release
brew "sccache"
brew "shellcheck"
brew "starship"
brew "tmux"
brew "tree"
brew "unzip"         # required by fonts role (unarchive module)
brew "uv"
brew "vim"
brew "wget"
brew "zsh"
brew "tstapler/homebrew-tap/consolette"
brew "tstapler/homebrew-tap/kibitzer"
